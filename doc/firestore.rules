rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.get('role', 'agent');
    }
    function isAuthenticated() { return request.auth != null; }
    function isSupervisor()    { return isAuthenticated() && getRole() == 'supervisor'; }
    function isAgent()         { return isAuthenticated(); }

    function isAllowedTicketUpdate() {
      let allowedFields = [
        'contactMethod', 'identifier', 'issueType', 'description',
        'dateReceived', 'timeReceived', 'status', 'timeToFirstResponse',
        'resolutionTime', 'rtInHours', 'resolutionDescription',
        'updatedBy', 'updatedAt', 'hasNewReply', 'typingBy', 'auditLog'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    match /tickets/{ticketId} {
      allow read:   if isAgent();
      allow create: if isAgent();
      allow update: if isAgent() && isAllowedTicketUpdate();
      allow delete: if isSupervisor();
    }

    match /agents/{userId} {
      allow read:  if isAuthenticated() && (request.auth.uid == userId || isSupervisor());
      allow create: if isAuthenticated() && request.auth.uid == userId
                       && request.resource.data.role == 'agent';
      allow update: if isSupervisor();
      allow delete: if isSupervisor();
    }

    // Preserves a record of who deleted a ticket and its final state.
    // Only supervisors can delete tickets in the first place, so only
    // supervisors should be able to write here. No update/delete allowed —
    // once written, a deletion record should be permanent.
    match /deletionLog/{ticketId} {
      allow read:   if isSupervisor();
      allow create: if isSupervisor();
      allow update: if false;
      allow delete: if false;
    }

    match /system/{docId} {
      allow read:  if isAgent();
      allow write: if false;
    }
  }
}