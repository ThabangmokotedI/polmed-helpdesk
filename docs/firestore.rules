rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.get('role', 'agent');
    }
    function isAuthenticated() { return request.auth != null; }
    function isSupervisor()    { return isAuthenticated() && getRole() == 'supervisor'; }
    function isAgent()         { return isAuthenticated(); }

    match /tickets/{ticketId} {
      allow read:   if isAgent();
      allow create: if isAgent();
      allow update: if isAgent();
      allow delete: if isSupervisor();
    }

    match /agents/{userId} {
      allow read:  if isAuthenticated() && (request.auth.uid == userId || isSupervisor());
      allow create: if isAuthenticated() && request.auth.uid == userId
                       && request.resource.data.role == 'agent';
      allow update: if isSupervisor();
      allow delete: if isSupervisor();
    }

    // System health heartbeat — read-only for agents, written only by the
    // Admin SDK from trusted server functions (never directly by a client).
    match /system/{docId} {
      allow read:  if isAgent();
      allow write: if false;
    }

    // Deletion audit trail — a record of who deleted a ticket, when, and
    // its final state, written client-side at the moment of deletion (only
    // supervisors can ever reach that code path, since deleteTicket() itself
    // is gated by currentRole === 'supervisor'). Immutable once written —
    // nobody, including supervisors, can edit or remove an entry after the
    // fact, so it stays a trustworthy record.
    match /deletionLog/{ticketId} {
      allow read:   if isAgent();
      allow create: if isSupervisor();
      allow update: if false;
      allow delete: if false;
    }
  }
}
